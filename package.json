{
  "name": "pseudocord.js",
  "version": "0.30.6-alpha.1",
  "description": "pseudocord.js es una biblioteca para Node.js y TypeScript que permite desarrollar bots de Discord utilizando pseudocódigo en español.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goldp-js/pseudocord.js.git"
  },
  "homepage": "https://github.com/Goldp-js/pseudocord.js#readme",
  "bugs": {
    "url": "https://github.com/Goldp-js/pseudocord.js/issues"
  },

  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vscode-extension"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\""
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "pg": "^8.16.3",
    "redis": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "discord",
    "discord.js",
    "pseudocode",
    "bot",
    "spanish",
    "pseudodiscord",
    "sqlite",
    "redis",
    "postgresql"
  ]
}
